{
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "allow": [
      "Bash(git commit:*)",
      "Bash(git commit)"
    ]
  },
  "model": "opus",
  "deniedMcpServers": [
    {
      "serverName": "claude_design"
    }
  ],
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash '/Users/levente.berky/.claude/hooks/herdr-agent-state.sh' session",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "bash '/Users/levente.berky/.claude/hooks/vault-session-start.sh'",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash '/Users/levente.berky/.claude/hooks/vault-event-nudge.sh'",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "mcp__atlassian__jira_transition_issue|mcp__atlassian__jira_add_comment",
        "hooks": [
          {
            "type": "command",
            "command": "bash '/Users/levente.berky/.claude/hooks/vault-event-nudge.sh'",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash '/Users/levente.berky/.claude/hooks/vault-stop-check.sh'",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "datadog@claude-plugins-official": true,
    "ruby-lsp@claude-plugins-official": true,
    "superpowers@claude-plugins-official": false
  },
  "effortLevel": "high",
  "skipWorkflowUsageWarning": true,
  "theme": "auto"
}
